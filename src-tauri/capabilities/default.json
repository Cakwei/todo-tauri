{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:3001"
        },
        {
          "url": "https://todo-api.cakwei.dev"
        }
      ]
    },
    "http:default",
    "store:default"
  ]
}